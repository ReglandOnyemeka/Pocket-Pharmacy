rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pocket Pharmacy Multi-Tenant Collections
    match /pharmacies/{pharmacyId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /tenants/{pharmacyId}/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
